# ConsentVid settings. Copy to .env (in the directory you run from) or to
# ~/.consentvid/config.env. Real environment variables take precedence.

# --- Contributor account (only needed for commands that write) ---------------
# Use an APP PASSWORD from https://bsky.app/settings/app-passwords, never your
# main password. Read-only commands (verify, resync, export --repo, appview)
# need no account.
CONSENTVID_HANDLE=you.bsky.social
CONSENTVID_APP_PASSWORD=
CONSENTVID_SERVICE=https://bsky.social

# Default storage backend for new videos: r2 | ipfs | peertube | url | local.
# If unset: r2 when configured, otherwise local (not usable in shared datasets).
CONSENTVID_STORAGE=

# --- Cloudflare R2 (--storage-kind r2) ----------------------------------------
CONSENTVID_R2_ENDPOINT=
CONSENTVID_R2_BUCKET=
CONSENTVID_R2_ACCESS_KEY_ID=
CONSENTVID_R2_SECRET_ACCESS_KEY=
CONSENTVID_R2_PUBLIC_URL=

# --- IPFS (--storage-kind ipfs) -----------------------------------------------
# With a Pinata JWT the bytes are pinned by a hosted service; without one they
# go to a local Kubo node. IPFS content cannot be reliably deleted later.
CONSENTVID_PINATA_JWT=
CONSENTVID_IPFS_API=http://127.0.0.1:5001
CONSENTVID_IPFS_GATEWAY=https://ipfs.io

# --- PeerTube (--storage-kind peertube) ---------------------------------------
CONSENTVID_PEERTUBE_URL=
CONSENTVID_PEERTUBE_USERNAME=
CONSENTVID_PEERTUBE_PASSWORD=
CONSENTVID_PEERTUBE_CHANNEL_ID=
# 1 public, 2 unlisted (default), 3 private
CONSENTVID_PEERTUBE_PRIVACY=2

# --- Advanced ------------------------------------------------------------------
# Force strict PDS-side lexicon validation (fails on bsky.social, which does not
# resolve third-party lexicons). Leave unset: records are always validated
# locally, and the PDS applies its default ("optimistic") policy.
CONSENTVID_VALIDATE=
# Where sessions, the AppView db and the C2PA signer live (default ~/.consentvid).
CONSENTVID_HOME=
# Jetstream endpoint for the AppView.
CONSENTVID_JETSTREAM_URL=wss://jetstream2.us-east.bsky.network/subscribe
