CONSENTVID_HANDLE=ekazakos.bsky.social
CONSENTVID_APP_PASSWORD=
CONSENTVID_SERVICE=https://bsky.social

# Optional: R2 storage backend (only needed for --storage-kind r2)
CONSENTVID_R2_ENDPOINT=
CONSENTVID_R2_BUCKET=
CONSENTVID_R2_ACCESS_KEY_ID=
CONSENTVID_R2_SECRET_ACCESS_KEY=
CONSENTVID_R2_PUBLIC_URL=

# Optional: IPFS storage backend (--storage-kind ipfs)
# With a Pinata JWT the bytes are pinned by a hosted service (durable); without
# one, uploads go to a local Kubo node (persist only while it runs + pins).
CONSENTVID_PINATA_JWT=
CONSENTVID_IPFS_API=http://127.0.0.1:5001
CONSENTVID_IPFS_GATEWAY=https://ipfs.io

# Optional: PeerTube storage backend (--storage-kind peertube)
CONSENTVID_PEERTUBE_URL=
CONSENTVID_PEERTUBE_USERNAME=
CONSENTVID_PEERTUBE_PASSWORD=
CONSENTVID_PEERTUBE_CHANNEL_ID=
CONSENTVID_PEERTUBE_PRIVACY=1

# Optional: lexicon validation. Set to 1 once org.consentvid.* lexicons are
# published and resolvable (see `consentvid publish-lexicons`); until then
# records are written with validate:false.
CONSENTVID_VALIDATE=0
