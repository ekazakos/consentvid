# ConsentVid settings. Copy to ~/.consentvid/config.env and `chmod 600` it.
# Only that file, the .env of a consentvid source checkout (editable installs),
# or a file named by $CONSENTVID_ENV_FILE (set in your real environment) is
# read -- never a .env in the current directory, because datasets are opened
# there. Only CONSENTVID_* keys are taken from files; real environment
# variables take precedence. Prefer `consentvid login` (caches a session) over
# storing the app password here at all.

# --- Contributor account (only needed for commands that write) ---------------
# Use an APP PASSWORD from https://bsky.app/settings/app-passwords, never your
# main password. Read-only commands (verify, resync, export --repo, appview)
# need no account.
CONSENTVID_HANDLE=you.bsky.social
CONSENTVID_APP_PASSWORD=
# Your PDS is found from your handle (handle -> DID -> DID document), so this
# is only an override. Must be https:// (http://localhost only with
# CONSENTVID_ALLOW_INSECURE=1 in your real environment, for a local dev PDS).
# CONSENTVID_SERVICE=https://bsky.social

# Default storage backend for new videos: r2 | ipfs | peertube | url | local.
# If unset: r2 when configured, otherwise local (not usable in shared datasets).
CONSENTVID_STORAGE=

# --- Cloudflare R2 (--storage-kind r2) ----------------------------------------
# `revoke --delete-bytes` deletes the content-addressed object videos/<sha256>.
# Do not use it on a bucket shared by several contributors: identical bytes
# share one object, and deleting it removes it for everyone.
CONSENTVID_R2_ENDPOINT=
CONSENTVID_R2_BUCKET=
CONSENTVID_R2_ACCESS_KEY_ID=
CONSENTVID_R2_SECRET_ACCESS_KEY=
CONSENTVID_R2_PUBLIC_URL=

# --- IPFS (--storage-kind ipfs) -----------------------------------------------
# With a Pinata JWT the bytes are pinned by a hosted service; otherwise they go
# to the Kubo node at CONSENTVID_IPFS_API (must be set explicitly, e.g.
# http://127.0.0.1:5001). IPFS content cannot be reliably deleted later.
CONSENTVID_PINATA_JWT=
CONSENTVID_IPFS_API=
CONSENTVID_IPFS_GATEWAY=https://ipfs.io

# --- PeerTube (--storage-kind peertube) ---------------------------------------
# Must be https://.
CONSENTVID_PEERTUBE_URL=
CONSENTVID_PEERTUBE_USERNAME=
CONSENTVID_PEERTUBE_PASSWORD=
CONSENTVID_PEERTUBE_CHANNEL_ID=
# 1 public, 2 unlisted (default), 3 private
CONSENTVID_PEERTUBE_PRIVACY=2

# --- Advanced ------------------------------------------------------------------
# Force strict PDS-side lexicon validation. Fails on any reference-implementation
# PDS today (none resolve third-party lexicons yet: "Unknown lexicon type"), and
# only after the video bytes are uploaded. Leave unset: records are always
# validated locally, and the PDS applies its default ("optimistic") policy.
CONSENTVID_VALIDATE=
# Where sessions, the AppView db and the C2PA signer live (default ~/.consentvid).
# Set it in your real environment; it is ignored in env files.
# CONSENTVID_HOME=
# Jetstream endpoint for the AppView (default: the v2 endpoint below). A v1
# /subscribe URL still works, but can't report too-old cursors or #sync events.
# CONSENTVID_JETSTREAM_URL=wss://jetstream.us-east.bsky.network/xrpc/network.bsky.jetstream.subscribeEvents
# Relay for `appview backfill --all` discovery and repo status checks.
# CONSENTVID_RELAY=https://relay1.us-east.bsky.network
