{
  "lexicon": 1,
  "id": "org.consentvid.video",
  "defs": {
    "main": {
      "type": "record",
      "description": "A video registered for inclusion in a consent-first dataset. Storage of the bytes is decoupled: this record only commits to a content hash and a pointer.",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["title", "contentHash", "storageRef", "createdAt"],
        "properties": {
          "title": {"type": "string", "maxLength": 300},
          "description": {"type": "string", "maxLength": 3000},
          "contentHash": {
            "type": "string",
            "description": "SHA-256 of the video bytes, hex-encoded with 'sha256-' prefix.",
            "maxLength": 80
          },
          "durationMs": {
            "type": "integer",
            "description": "Duration in milliseconds. ATproto records have no float type."
          },
          "width": {"type": "integer"},
          "height": {"type": "integer"},
          "language": {
            "type": "string",
            "description": "BCP-47 language tag for primary audio if any."
          },
          "tags": {
            "type": "array",
            "items": {"type": "string", "maxLength": 64},
            "maxLength": 32
          },
          "storageRef": {"type": "ref", "ref": "#storageRef"},
          "createdAt": {"type": "string", "format": "datetime"}
        }
      }
    },
    "storageRef": {
      "type": "object",
      "required": ["kind", "value"],
      "properties": {
        "kind": {
          "type": "string",
          "knownValues": ["url", "local", "ipfs", "r2", "peertube"]
        },
        "value": {"type": "string"}
      }
    }
  }
}
